# Copy to .env and fill in real values. .env itself is gitignored -- never commit it.

# Self-hosted Postgres (auth + app state -- see docs/agent_ui_architecture_plan.md).
# Matches docker-compose.yml's default local dev credentials.
DATABASE_URL=postgresql+asyncpg://epl:epl@localhost:5432/epl

# Dev-only placeholder. Generate a real secret before this touches real user
# data, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-dev-only

# Claude API key for the agent loop (not yet implemented).
ANTHROPIC_API_KEY=

# Defaults to db/epl.duckdb relative to the repo root if unset.
DUCKDB_PATH=
